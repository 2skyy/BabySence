# IDE
.idea/
.vscode/*
# 실행 설정은 팀과 공유합니다 (env.json 주입에 필요)
!.vscode/launch.json
*.iml
*.ipr
*.iws

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.buildlog/
.history
.svn/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub/

# Build artifacts
# 앞에 /를 붙이면 최상위만 걸러집니다. android/build 같은 하위 산출물이
# 새어 들어와 빌드할 때마다 git status가 더러워집니다.
build/
/android/app/debug
/android/app/profile
/android/app/release

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# 환경 설정 (env.example.json을 복사해서 만드세요)
env.json

# API 키. 절대 커밋하지 마세요.
# 서버는 ANTHROPIC_API_KEY를 여기서 읽습니다(server/README.md 참고).
.env
*.env
!*.env.example
# 골든 테스트 실패 시 생성되는 비교 이미지
**/failures/

# 논문 원고. 저장소에 넣지 않습니다(바이너리, diff 불가).
*.docx
*.hwp
*.hwpx

# flutter create로 생긴 빈 템플릿. 본 프로젝트와 무관합니다.
# 지워도 빌드하면 산출물이 다시 생겨 커밋에 쓸려 들어갑니다.
my_app/

# FCM 설정. 프로젝트마다 다르고 공개 저장소에 올릴 것이 아닙니다.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
